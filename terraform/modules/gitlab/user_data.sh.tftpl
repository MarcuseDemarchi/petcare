#!/bin/bash
# O bootstrap do GitLab NÃO pode rodar dentro do cloud-init: o serviço gitlab-runsvdir
# tem After=multi-user.target, que só é atingido quando o cloud-init termina -> deadlock.
# Por isso o user_data apenas instala o script como serviço systemd e o dispara sem bloquear.
set -euo pipefail
echo '${bootstrap_b64}' | base64 -d > /usr/local/sbin/petcare-gitlab-bootstrap.sh
chmod 700 /usr/local/sbin/petcare-gitlab-bootstrap.sh
cat > /etc/systemd/system/petcare-gitlab-bootstrap.service <<'UNIT'
[Unit]
Description=Bootstrap do GitLab CE + Runner (PetCare)
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/petcare-gitlab-ready

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/petcare-gitlab-bootstrap.sh
TimeoutStartSec=0
UNIT
systemctl daemon-reload
systemctl start --no-block petcare-gitlab-bootstrap.service
